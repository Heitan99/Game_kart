# KART CAMPUS — variables de entorno del servidor
# Copia este archivo a .env y ajusta los valores.

# Puerto HTTP/WSS del servidor
PORT=3000

# Interfaz de escucha (0.0.0.0 permite acceso desde la red local / Internet)
HOST=0.0.0.0

# Origen(es) permitidos para CORS, separados por coma.
# En producción usa tu dominio exacto, p. ej. https://kartcampus.example.com
ALLOWED_ORIGIN=http://localhost:3000

# Entorno: development | production
NODE_ENV=development

# Segundos que se conserva la plaza de un jugador desconectado para reconectar
RECONNECT_GRACE=30

# Máximo de jugadores humanos por sala
MAX_PLAYERS=8

# Segundos de vida de una sala vacía antes de eliminarse
EMPTY_ROOM_TTL=60

# Cadencia del servidor (Hz). No cambiar sin ajustar shared/GameConfig.js.
SERVER_TICK_HZ=60