{
  "name": "kart-campus",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "KART CAMPUS — carreras arcade 3D multijugador online. Cliente Three.js + servidor autoritativo Socket.IO.",
  "main": "server/src/server.js",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "test": "node --test --test-force-exit \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:unit": "node --test --test-force-exit \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-force-exit \"tests/integration/**/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "smoke": "node scripts/smoke.js",
    "smoke:solo": "node scripts/smoke-solo.js",
    "smoke:online": "node scripts/smoke-online.js",
    "smoke:race": "node scripts/smoke-race.js"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5"
  },
  "engines": {
    "node": ">=18"
  }
}